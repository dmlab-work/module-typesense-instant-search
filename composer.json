{
    "name": "dmlab/module-typesense-instant-search",
    "description": "Instant, typo-tolerant search-as-you-type dropdown for Magento 2 Luma, powered by Typesense. Free and uncapped.",
    "type": "magento2-module",
    "license": "OSL-3.0",
    "version": "0.2.1",
    "keywords": [
        "magento2",
        "magento2-module",
        "magento 2",
        "typesense",
        "instant search",
        "autocomplete",
        "search as you type",
        "typo tolerance",
        "search suggestions",
        "quick search",
        "luma"
    ],
    "authors": [
        {
            "name": "DMLab",
            "homepage": "https://dmlab.work"
        }
    ],
    "homepage": "https://github.com/dmlab-work/module-typesense-instant-search",
    "support": {
        "issues": "https://github.com/dmlab-work/module-typesense-instant-search/issues",
        "source": "https://github.com/dmlab-work/module-typesense-instant-search"
    },
    "require": {
        "php": "~8.2.0||~8.3.0||~8.4.0||~8.5.0",
        "magento/framework": "^103.0.7",
        "magento/module-backend": "^102.0.7",
        "magento/module-catalog": "^104.0.7",
        "magento/module-catalog-search": "^102.0.7",
        "magento/module-customer": "^103.0.7",
        "magento/module-search": "^101.1.7",
        "magento/module-csp": "^100.4.6",
        "magento/module-store": "^101.1.7",
        "magento/module-config": "^101.2.7",
        "magento/module-tax": "^100.4.7",
        "magento/module-directory": "^100.4.7",
        "magento/module-ui": "^101.2.7",
        "psr/log": "^2.0||^3.0",
        "dmlab/module-typesense-core": "^0.2.0",
        "dmlab/module-typesense-indexer": "^0.2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5||^12.5"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "DmLab\\TypesenseInstantSearch\\": ""
        }
    }
}
