<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="dmlab_typesense" showInDefault="1" showInWebsite="1" showInStore="1">
            <group id="instant_search" translate="label" type="text" sortOrder="40"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Instant Search</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Instant Search</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Replaces the stock autocomplete with typo-tolerant search-as-you-type. Without a provisioned key the storefront keeps native search.</comment>
                </field>
                <field id="mode" translate="label comment" type="select" sortOrder="12"
                       showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Query Mode</label>
                    <source_model>DmLab\TypesenseInstantSearch\Model\Config\Source\Mode</source_model>
                    <comment><![CDATA[<strong>Proxy</strong> (default): the browser queries a Magento endpoint; Typesense stays private, no public host or CSP needed. <strong>Direct</strong>: guests query the public Typesense collection with a scoped read-only key — lowest latency, but requires exposing Typesense over HTTPS. Logged-in customers always use the proxy.]]></comment>
                </field>
                <field id="key_status" translate="label comment" type="label" sortOrder="15"
                       showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Search-Only Key</label>
                    <frontend_model>DmLab\TypesenseInstantSearch\Block\Adminhtml\System\Config\KeyStatus</frontend_model>
                    <comment><![CDATA[Per-store keys, created from the Typesense admin key on save, on store/website save, or with <code>bin/magento dmlab:typesense:search-key:ensure</code>. Only derived scoped keys reach the browser.]]></comment>
                </field>
                <field id="regenerate_key" translate="label" type="button" sortOrder="16"
                       showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Regenerate Key</label>
                    <frontend_model>DmLab\TypesenseInstantSearch\Block\Adminhtml\System\Config\RegenerateButton</frontend_model>
                </field>
                <field id="public_host" translate="label comment" type="text" sortOrder="20"
                       showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Public Typesense Host</label>
                    <comment><![CDATA[Publicly reachable Typesense host the browser connects to, e.g. <code>search.example.com</code>. May differ from the server-side host under Catalog Search. The browser always connects over <strong>HTTPS</strong>; include a non-standard port in the value itself (e.g. <code>search.example.com:8108</code>).]]></comment>
                    <depends>
                        <field id="mode">direct</field>
                    </depends>
                </field>
                <field id="min_query_length" translate="label comment" type="text" sortOrder="30"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Minimum Query Length</label>
                    <comment>Characters that must be typed before a request is sent.</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="result_limit" translate="label comment" type="text" sortOrder="40"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Result Limit</label>
                    <comment>Maximum number of suggestions shown in the dropdown.</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="debounce_ms" translate="label comment" type="text" sortOrder="50"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Debounce (ms)</label>
                    <comment>Milliseconds to wait after the last keystroke before querying.</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="display_title" translate="label" type="select" sortOrder="60"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Show Title</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="display_image" translate="label" type="select" sortOrder="70"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Show Image</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="display_price" translate="label" type="select" sortOrder="80"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Show Price</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="display_sku" translate="label" type="select" sortOrder="90"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Show SKU</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
            </group>
        </section>
    </system>
</config>
