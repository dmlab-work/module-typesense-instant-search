<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!--
        The per-store parent keys are credentials and their ids/collections must stay paired with them in the DB:
        mark all sensitive so a config dump never leaks a key or pins stale state in app/etc/config.php.
        The legacy 0.1.x key stays listed until LegacyKeyMigrator is removed.
    -->
    <type name="Magento\Config\Model\Config\TypePool">
        <arguments>
            <argument name="sensitive" xsi:type="array">
                <item name="dmlab_typesense/instant_search/public_key" xsi:type="string">1</item>
                <item name="dmlab_typesense/instant_search/proxy_key" xsi:type="string">1</item>
                <item name="dmlab_typesense/instant_search/public_key_id" xsi:type="string">1</item>
                <item name="dmlab_typesense/instant_search/proxy_key_id" xsi:type="string">1</item>
                <item name="dmlab_typesense/instant_search/public_key_collection" xsi:type="string">1</item>
                <item name="dmlab_typesense/instant_search/proxy_key_collection" xsi:type="string">1</item>
                <item name="dmlab_typesense/instant_search/search_api_key" xsi:type="string">1</item>
            </argument>
        </arguments>
    </type>

    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="dmlab_typesense_search_key_ensure" xsi:type="object">
                    DmLab\TypesenseInstantSearch\Console\Command\SearchKeyEnsureCommand
                </item>
                <item name="dmlab_typesense_search_key_regenerate" xsi:type="object">
                    DmLab\TypesenseInstantSearch\Console\Command\SearchKeyRegenerateCommand
                </item>
            </argument>
        </arguments>
    </type>
    <!-- Proxy: CommandList builds every command on each bin/magento run. -->
    <type name="DmLab\TypesenseInstantSearch\Console\Command\AbstractSearchKeyCommand">
        <arguments>
            <argument name="provisioner" xsi:type="object">
                DmLab\TypesenseInstantSearch\Model\Key\SearchKeyProvisioner\Proxy
            </argument>
        </arguments>
    </type>

    <!-- Key ids read before the resource delete, revoked after it succeeds. -->
    <type name="Magento\Store\Model\ResourceModel\Store">
        <plugin name="dmlab_typesense_instant_search_revoke_keys"
                type="DmLab\TypesenseInstantSearch\Plugin\RevokeSearchKeysOnDelete"/>
    </type>
    <type name="Magento\Store\Model\ResourceModel\Group">
        <plugin name="dmlab_typesense_instant_search_revoke_keys"
                type="DmLab\TypesenseInstantSearch\Plugin\RevokeSearchKeysOnDelete"/>
    </type>
    <type name="Magento\Store\Model\ResourceModel\Website">
        <plugin name="dmlab_typesense_instant_search_revoke_keys"
                type="DmLab\TypesenseInstantSearch\Plugin\RevokeSearchKeysOnDelete"/>
    </type>

    <!--
        The browser queries Typesense directly, so its configured public host must be an allowed
        connect-src origin. The host is admin config, not a literal, so it cannot live in the static
        etc/csp_whitelist.xml; this collector merges it in at runtime.
    -->
    <type name="Magento\Csp\Model\CompositePolicyCollector">
        <arguments>
            <argument name="collectors" xsi:type="array">
                <item name="dmlab_typesense_instant_search" xsi:type="object" sortOrder="200">
                    DmLab\TypesenseInstantSearch\Model\Csp\TypesensePolicyCollector
                </item>
            </argument>
        </arguments>
    </type>
</config>
