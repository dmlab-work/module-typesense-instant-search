<?php
/**
 * Copyright © MageDevGroup. All rights reserved.
 *
 * Emits the instant-search config for the storefront widget. The view model fails
 * closed (empty string when the widget must not run), so nothing is printed and the
 * native Magento autocomplete stays in place. The JSON carries only configuration —
 * the mode and its fetch contract (proxy: the same-origin endpoint; direct: host, derived
 * scoped key, collection alias, query_by/weights, display fields) plus limits — never the
 * admin/parent key or product data, so it is safe to embed verbatim in a JSON script block.
 *
 * @var \Magento\Framework\View\Element\Template $block
 */

/** @var \MageDevGroup\TypesenseInstantSearch\ViewModel\InstantSearchConfig $viewModel */
$viewModel = $block->getViewModel();
$json = $viewModel->getJsonConfig();
?>
<?php if ($json !== '') : ?>
<script type="application/json" id="magedevgroup-typesense-instant-search-config">
    <?= /* @noEscape */ $json ?>
</script>
<?php endif; ?>
